<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#000000" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>Meta </title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: #ffffff;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
			}

			.container {
				background: white;
				border-radius: 0;
				border: 3px solid #000000;
				padding: 3rem;
				max-width: 600px;
				width: 100%;
			}

			h1 {
				color: #000000;
				margin-bottom: 2rem;
				font-size: 2rem;
				font-weight: 900;
				text-transform: uppercase;
			}

			button {
				background: #000000;
				color: white;
				border: 2px solid #000000;
				padding: 1rem 2rem;
				border-radius: 0;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				width: 100%;
				transition: all 0.3s ease;
				text-transform: uppercase;
			}

			button:hover {
				background: #333333;
				transform: translateY(-2px);
			}

			button:disabled {
				background: #cccccc;
				border-color: #cccccc;
				cursor: not-allowed;
				transform: none;
			}

			button.secondary {
				background: white;
				color: #000000;
				border: 2px solid #000000;
			}

			button.secondary:hover {
				background: #f0f0f0;
			}

			button.primary {
				background: #000000;
				color: white;
				border: 2px solid #000000;
			}

			button.primary:hover {
				background: #333333;
			}

			.user-info {
				background: #000000;
				color: #ffffff;
				padding: 1rem;
				margin-bottom: 1.5rem;
				text-align: center;
				border: 2px solid #000000;
			}

			.user-info p {
				margin: 0;
				font-size: 0.95rem;
			}

			.user-info strong {
				font-weight: 700;
				text-transform: uppercase;
			}
		</style>
	</head>
	<body>
		<div class="container">
			<h1>Meta IA</h1>

			<!-- El contenido de los botones se genera dinámicamente -->
			<div id="actions"></div>
		</div>

		<script>
			// Función para cerrar sesión (DEBE estar en el scope global)
			(window as any).logout = function() {
				console.log('🔓 Cerrando sesión...');
				localStorage.removeItem('meta_access_token');
				localStorage.removeItem('meta_user_id');
				localStorage.removeItem('meta_user_name');
				console.log('✅ Sesión cerrada');
				window.location.reload();
			};

			// Verificar si el usuario ya está autenticado
			const accessToken = localStorage.getItem('meta_access_token');
			const userName = localStorage.getItem('meta_user_name');
			const actionsDiv = document.getElementById('actions');

			if (!actionsDiv) {
				console.error('Actions div not found');
			} else if (accessToken) {
				// Usuario YA autenticado → Mostrar acceso directo al dashboard
				console.log(' Usuario autenticado:', userName);
				actionsDiv.innerHTML = `
					<div class="user-info">
						<p>Conectado como: <strong>${userName || 'Usuario'}</strong></p>
					</div>
					<button class="btn primary" onclick="window.location.href='/dashboard'">
						Ir al Dashboard
					</button>
					<button class="btn secondary" id="logoutBtn" style="margin-top: 1rem;">
						Cerrar Sesión
					</button>
				`;

				// Agregar event listener al botón de logout
				const logoutBtn = document.getElementById('logoutBtn');
				if (logoutBtn) {
					logoutBtn.addEventListener('click', (window as any).logout);
				}
			} else {
				// Usuario NO autenticado → Mostrar botón de login
				console.log(' Usuario NO autenticado');
				actionsDiv.innerHTML = `
					<button class="btn primary" onclick="window.location.href='/auth/login'">
						Meta
					</button>
				`;
			}
		</script>
	</body>
</html>
