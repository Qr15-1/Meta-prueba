---
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Cliente</title>
    <style>
      :root {
        --bg: #f5f6fb;
        --card: #ffffff;
        --text: #15151a;
        --muted: #6b7280;
        --line: #e8ecf4;
        --accent: #3b82f6;
        --accent-2: #f59e0b;
        --shadow: 0 4px 12px rgba(15, 23, 42, 0.05); /* Sombra más sutil */
        --radius: 16px;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      .page {
        max-width: 1200px;
        margin: 32px auto;
        padding: 0 20px 40px;
      }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
      }
      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .subtitle {
        margin-top: 6px;
        font-size: 14px;
        color: var(--muted);
      }
      .top-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .date-pill {
        background: var(--card);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 13px;
        color: var(--muted);
        box-shadow: var(--shadow);
      }
      button {
        padding: 10px 16px;
        background: var(--text);
        color: #fff;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-weight: 600;
      }
      
      /* --- Estilos para las Tarjetas de KPI (SOLUCIÓN) --- */
      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
        align-items: stretch;
      }
      
      /* Estilo base para todas las tarjetas (KPIs y Gráficos) */
      .kpi-card,
      .card {
        background: var(--card);
        border-radius: var(--radius);
        padding: 22px;
        box-shadow: var(--shadow);
        border: 1px solid var(--line);
      }
      
      /* Estilo específico para las tarjetas de resumen (KPIs) */
      .kpi-card {
        min-height: 240px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
      }
      
      .kpi-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .kpi-label {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
      }
      .kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #f1f5f9;
        display: grid;
        place-items: center;
        color: #64748b;
        font-size: 16px;
      }
      .kpi-icon.accent-2 {
        background: #fef3c7; /* Fondo para el acento 2 (CTR) */
        color: #b45309;
      }
      .kpi-value {
        font-size: 34px;
        font-weight: 800;
        margin: 0;
      }
      .kpi-note {
        font-size: 13px;
        color: var(--muted);
      }
      /* --- Fin Estilos para las Tarjetas de KPI --- */
      
      .content-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 16px;
      }
      .span-2 {
        grid-column: span 12;
      }
      @media (min-width: 900px) {
        .span-2 {
          grid-column: span 8;
        }
        .span-1 {
          grid-column: span 4;
        }
      }
      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
      }
      .card-title {
        font-weight: 700;
      }
      .card-subtitle {
        font-size: 12px;
        color: var(--muted);
        margin-top: 4px;
      }
      .badge {
        background: #eef2ff;
        color: #4338ca;
        font-weight: 600;
        font-size: 12px;
        padding: 6px 10px;
        border-radius: 999px;
      }
      .badge.ghost {
        background: #f3f4f6;
        color: var(--muted);
      }
      .donut-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .donut {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: conic-gradient(var(--accent) calc(var(--pct) * 1%), #e9edf5 0);
        position: relative;
      }
      .donut.accent-2 {
        background: conic-gradient(var(--accent-2) calc(var(--pct) * 1%), #e9edf5 0);
      }
      .donut::after {
        content: '';
        position: absolute;
        inset: 16px;
        background: #ffffff;
        border-radius: 50%;
      }
      .donut-legend {
        display: grid;
        gap: 8px;
        font-size: 12px;
        color: var(--muted);
      }
      .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
      }
      .dot.muted {
        background: #e9edf5;
      }
      .dot.accent-2 {
        background: var(--accent-2);
      }
      .bars {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
        align-items: end;
        height: 160px;
      }
      .bar {
        background: #f1f5f9;
        border-radius: 10px;
        position: relative;
        overflow: hidden;
      }
      .bar-fill {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(180deg, #60a5fa, #2563eb);
        border-radius: 10px 10px 0 0;
      }
      .bar-labels {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
        margin-top: 12px;
        font-size: 11px;
        color: var(--muted);
        text-align: center;
      }
      .mini-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
      }
      .mini-card {
        padding: 14px;
        background: #f8fafc;
        border-radius: 12px;
      }
      .mini-label {
        font-size: 12px;
        color: var(--muted);
      }
      .mini-value {
        font-weight: 700;
        margin-top: 6px;
      }
      .empty {
        padding: 32px;
        text-align: center;
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <div>
          <div class="eyebrow"></div>
          <h1 id="brandTitle">Cargando...</h1>
          <div id="brandSubtitle" class="subtitle"></div>
        </div>
        <div class="top-actions">
          <div id="lastDate" class="date-pill">--</div>
          <button id="logoutBtn">Salir</button>
        </div>
      </header>

      <section style="margin-bottom: 24px;">
        <div class="card-header" style="margin-bottom: 12px;">
          <div>
            <div class="card-title">Resumen principal</div>
            <div class="card-subtitle"></div>
          </div>
        </div>
        <div id="kpiGrid" class="kpi-grid"></div>
      </section>

      <section class="content-grid">
        <div class="card span-1">
          <div class="card-header">
            <div>
              <div class="card-title">Alcance vs Impresiones</div>
              <div class="card-subtitle">Porcentaje de alcance</div>
            </div>
            <div id="reachPct" class="badge">--%</div>
          </div>
          <div class="donut-wrap">
            <div id="reachDonut" class="donut" style="--pct: 0"></div>
            <div class="donut-legend">
              <div class="legend-item"><span class="dot"></span> Alcance</div>
              <div class="legend-item"><span class="dot muted"></span> Impresiones</div>
            </div>
          </div>
        </div>

        <div class="card span-1">
          <div class="card-header">
            <div>
              <div class="card-title">CTR y Clics</div>
              <div class="card-subtitle">Porcentaje de clics</div>
            </div>
            <div id="ctrPct" class="badge">--%</div>
          </div>
          <div class="donut-wrap">
            <div id="ctrDonut" class="donut accent-2" style="--pct: 0"></div>
            <div class="donut-legend">
              <div class="legend-item"><span class="dot accent-2"></span> Clics</div>
              <div class="legend-item"><span class="dot muted"></span> Impresiones</div>
            </div>
          </div>
        </div>

        <div class="card span-2">
          <div class="card-header">
            <div>
              <div class="card-title">Actividad</div>
              <div class="card-subtitle">Resumen del último guardado</div>
            </div>
            <div id="activityDate" class="badge ghost">--</div>
          </div>
          <div id="barChart" class="bars"></div>
          <div id="barLabels" class="bar-labels"></div>
        </div>

        <div class="card span-2">
          <div class="card-header">
            <div>
              <div class="card-title">Detalle de costos</div>
              <div class="card-subtitle">Métricas clave del día</div>
            </div>
          </div>
          <div id="miniGrid" class="mini-grid"></div>
        </div>
      </section>

      <div id="emptyState" class="empty" style="display: none;">No hay datos todavía.</div>
    </div>

    <script>
      const kpiGrid = document.getElementById('kpiGrid');
      const miniGrid = document.getElementById('miniGrid');
      const lastDateEl = document.getElementById('lastDate');
      const reachDonut = document.getElementById('reachDonut');
      const ctrDonut = document.getElementById('ctrDonut');
      const reachPct = document.getElementById('reachPct');
      const ctrPct = document.getElementById('ctrPct');
      const barChart = document.getElementById('barChart');
      const barLabels = document.getElementById('barLabels');
      const activityDate = document.getElementById('activityDate');
      const emptyState = document.getElementById('emptyState');
      const brandTitle = document.getElementById('brandTitle');
      const brandSubtitle = document.getElementById('brandSubtitle');
      const logoutBtn = document.getElementById('logoutBtn');

      function formatMoney(value: number) {
        return `$${Number(value || 0).toFixed(2)}`;
      }

      function formatNumber(value: number) {
        return Number(value || 0).toLocaleString('es');
      }

      function formatDate(value: string | null | undefined) {
        if (!value) return '--';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '--';
        return date.toLocaleDateString('es-CO');
      }

      function setDonut(el: Element | null, percent: number) {
        if (!el) return;
        const safe = Math.max(0, Math.min(100, percent));
        el.setAttribute('style', `--pct: ${safe}`);
      }

      async function load() {
        const meRes = await fetch('/api/portal/me');
        if (!meRes.ok) {
          window.location.href = '/portal/login';
          return;
        }
        const me = await meRes.json();
        if (brandTitle) brandTitle.textContent = me.marca?.nombre || 'Portal Cliente';
        if (brandSubtitle) brandSubtitle.textContent = me.user?.email || '';

        const res = await fetch('/api/portal/metrics');
        const data = await res.json();
        const row = data.data;
        if (!kpiGrid || !miniGrid || !barChart || !barLabels) return;
        if (!row) {
          if (emptyState) emptyState.style.display = 'block';
          return;
        }
        if (emptyState) emptyState.style.display = 'none';

        const fecha = formatDate(row.fecha);
        if (lastDateEl) lastDateEl.textContent = fecha;
        if (activityDate) activityDate.textContent = fecha;

        const items = [
          { label: 'Alcance', value: formatNumber(row.alcance), note: 'Último guardado' },
          { label: 'Impresiones', value: formatNumber(row.impresiones), note: 'Total del día' },
          { label: 'Clics', value: formatNumber(row.clics), note: 'Interacciones' },
          { label: 'CTR', value: `${Number(row.ctr || 0).toFixed(2)}%`, note: 'Tasa de clics' },
          { label: 'Gasto', value: formatMoney(row.gasto), note: 'Inversión total' },
          { label: 'Mensajes', value: formatNumber(row.mensajes_iniciados), note: 'Conversaciones' }
        ];

        kpiGrid.innerHTML = items
          .map((item) => {
            let icon = '📊';
            let colorClass = '';
            if (item.label.includes('Alcance')) icon = '';
            if (item.label.includes('Gasto')) icon = '';
            if (item.label.includes('Impresiones')) icon = '';
            if (item.label.includes('Clics')) icon = '';
            if (item.label.includes('Mensajes')) icon = '';
            if (item.label.includes('CTR')) {
              icon = '';
              colorClass = 'accent-2';
            }
            return `
              <div class="kpi-card" style="background:#fff;border:1px solid #e8ecf4;box-shadow:0 12px 30px rgba(15, 23, 42, 0.08);border-radius:16px;padding:18px;">
                <div class="kpi-header">
                  <div class="kpi-label">${item.label}</div>
                  <div class="kpi-icon ${colorClass}">${icon}</div>
                </div>
                <div class="kpi-value">${item.value}</div>
                <div class="kpi-note">${item.note}</div>
              </div>
            `;
          })
          .join('');

        const miniItems = [
          { label: 'Costo por clic', value: formatMoney(row.cpc) },
          { label: 'CPM', value: formatMoney(row.cpm) },
          { label: 'Frecuencia', value: Number(row.frequency || 0).toFixed(2) },
          { label: 'Costo por mensaje', value: formatMoney(row.cost_per_messaging) },
          { label: 'Visitas al perfil', value: formatNumber(row.profile_visits) },
          { label: 'Anuncios en entrega', value: formatNumber(row.delivered_ads_count) }
        ];

        miniGrid.innerHTML = miniItems
          .map(
            (item) => `
              <div class="mini-card">
                <div class="mini-label">${item.label}</div>
                <div class="mini-value">${item.value}</div>
              </div>
            `
          )
          .join('');

        const impressions = Number(row.impresiones || 0);
        const reach = Number(row.alcance || 0);
        const clicks = Number(row.clics || 0);
        const reachPercent = impressions > 0 ? (reach / impressions) * 100 : 0;
        const ctrPercent = impressions > 0 ? (clicks / impressions) * 100 : 0;

        setDonut(reachDonut, reachPercent);
        setDonut(ctrDonut, ctrPercent);
        if (reachPct) reachPct.textContent = `${reachPercent.toFixed(1)}%`;
        if (ctrPct) ctrPct.textContent = `${ctrPercent.toFixed(1)}%`;

        const barValues = [
          { label: 'Alcance', value: reach },
          { label: 'Impresiones', value: impressions },
          { label: 'Clics', value: clicks },
          { label: 'Mensajes', value: Number(row.mensajes_iniciados || 0) },
          { label: 'Visitas', value: Number(row.profile_visits || 0) },
          { label: 'Anuncios', value: Number(row.delivered_ads_count || 0) }
        ];
        const maxValue = Math.max(...barValues.map((item) => item.value), 1);
        barChart.innerHTML = barValues
          .map((item) => {
            const height = Math.max(10, Math.round((item.value / maxValue) * 100));
            return `
              <div class="bar">
                <div class="bar-fill" style="height: ${height}%"></div>
              </div>
            `;
          })
          .join('');
        barLabels.innerHTML = barValues.map((item) => `<div>${item.label}</div>`).join('');
      }

      logoutBtn?.addEventListener('click', async () => {
        document.cookie = 'portal_session=; Path=/; Max-Age=0';
        window.location.href = '/portal/login';
      });

      load();
    </script>
  </body>
</html>
