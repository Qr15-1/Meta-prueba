---
// Callback después de la autenticación OAuth
// Los parámetros se leen del lado del cliente con JavaScript
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Autenticación - Meta OAuth</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #ffffff;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .container {
        background: white;
        border-radius: 0;
        border: 3px solid #000000;
        padding: 3rem;
        max-width: 600px;
        width: 100%;
        text-align: center;
      }

      .spinner {
        display: inline-block;
        width: 50px;
        height: 50px;
        border: 5px solid #cccccc;
        border-top-color: #000000;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      h1 {
        color: #000000;
        margin-bottom: 1rem;
        text-transform: uppercase;
        font-weight: 900;
      }

      .success {
        font-size: 4rem;
        margin-bottom: 1rem;
      }

      .error {
        font-size: 4rem;
        margin-bottom: 1rem;
      }

      .message {
        color: #666666;
        margin-bottom: 2rem;
        line-height: 1.6;
      }

      .btn {
        background: #000000;
        color: white;
        border: 2px solid #000000;
        padding: 1rem 2rem;
        border-radius: 0;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-transform: uppercase;
      }

      .btn:hover {
        background: #333333;
        transform: translateY(-2px);
      }

      .code-box {
        background: #f5f5f5;
        border: 2px solid #000000;
        padding: 1rem;
        border-radius: 0;
        margin: 1rem 0;
        word-break: break-all;
        font-family: monospace;
        font-size: 0.9rem;
        color: #000000;
      }
    </style>
  </head>
  <body>
    <div class="container" id="container">
      <div class="spinner"></div>
      <h1>Procesando Autenticación...</h1>
      <p class="message">
        Estamos intercambiando el código por un token de acceso.
      </p>
    </div>

    <script>
      // Leer parámetros de la URL del lado del cliente
      const urlParams = new URLSearchParams(window.location.search);
      const code = urlParams.get('code');
      const error = urlParams.get('error');
      const errorDescription = urlParams.get('error_description');
      
      const container = document.getElementById('container');

      if (error) {
        // Mostrar error
        if (container) {
          container.innerHTML = `
            <h1>Error en la Autenticación</h1>
            <p class="message">${errorDescription || 'No se pudo completar la autenticación'}</p>
            <a href="/auth/login" class="btn">Intentar de Nuevo</a>
          `;
        }
      } else if (code) {
        // Código recibido, intercambiar por token
        if (container) {
          container.innerHTML = `
            <div class="spinner"></div>
            <h1>Procesando Autenticación...</h1>
            <p class="message">Estamos intercambiando el código por un token de acceso.</p>
            <div class="code-box">Código recibido: ${code.substring(0, 20)}...</div>
          `;
        }

        // Intercambiar código por token
        exchangeCodeForToken(code);
      } else {
        // No hay código ni error
        if (container) {
          container.innerHTML = `
            <h1>Código no recibido</h1>
            <p class="message">No se recibió un código de autorización de Meta.</p>
            <a href="/auth/login" class="btn">Volver a Intentar</a>
          `;
        }
      }

      async function exchangeCodeForToken(code: string) {
        try {
          const response = await fetch('/api/auth/exchange-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
          });

          const data = await response.json();

          if (data.success) {
            // Guardar token en localStorage
            localStorage.setItem('meta_access_token', data.accessToken);
            localStorage.setItem('meta_user_id', data.userId);
            localStorage.setItem('meta_user_name', data.userName);
            
            if (container) {
              container.innerHTML = `
                <h1>Autenticación Exitosa</h1>
                <p class="message">Bienvenido ${data.userName}. Redirigiendo al dashboard...</p>
              `;
            }

            // Redirigir al dashboard después de 1 segundo
            setTimeout(() => {
              window.location.href = '/dashboard?auth=success';
            }, 1000);
          } else {
            console.error('Error data:', data);
            if (container) {
              container.innerHTML = `
                <h1>Error al obtener token</h1>
                <p class="message">${data.message}</p>
                ${data.details ? `<div class="code-box">Detalles: ${data.details}</div>` : ''}
                ${data.error_code ? `<div class="code-box">Error Code: ${data.error_code}</div>` : ''}
                <a href="/auth/login" class="btn" style="margin-top: 1rem;">Intentar de Nuevo</a>
              `;
            }
          }
        } catch (error: any) {
          if (container) {
            container.innerHTML = `
              <h1>Error de red</h1>
              <p class="message">No se pudo conectar con el servidor.</p>
              <a href="/auth/login" class="btn">Intentar de Nuevo</a>
            `;
          }
        }
      }
    </script>
  </body>
</html>

